{
  "name": "@graphentra/visualizer",
  "version": "1.0.0",
  "description": "Visualizer server and animated impact explorer for Graphentra",
  "license": "ISC",
  "main": "dist/visualize.js",
  "types": "dist/visualize.d.ts",
  "bin": {
    "graphentra-visualize": "dist/visualize.js"
  },
  "exports": {
    ".": {
      "types": "./dist/visualize.d.ts",
      "default": "./dist/visualize.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck:src": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run typecheck:src && npm run typecheck:test",
    "test": "tsx --test test/*.test.ts test/*.test.mjs",
    "visualize": "tsx src/visualize.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "ajv": "8.17.1"
  }
}
