{
  "name": "@graphentra/analyzer",
  "version": "0.4.0",
  "description": "Deterministic change-evidence and graph analyzer for TypeScript",
  "license": "ISC",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "graphentra-analyze": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./evidence.schema.json": "./evidence.schema.json"
  },
  "files": [
    "dist",
    "README.md",
    "evidence.schema.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck:src": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run typecheck:src && npm run typecheck:test",
    "test": "tsx --test test/*.test.ts",
    "analyze": "tsx src/cli.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
